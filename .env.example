# Database connection (SQLite for local zero-config, PostgreSQL for production/Docker)
DATABASE_URL="file:./dev.db"
# For PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartpark?schema=public"

# Authentication
JWT_SECRET="replace-with-a-secure-random-secret-min-32-characters"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
PORT=3000
